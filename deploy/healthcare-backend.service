[Unit]
Description=Healthcare Go Backend
After=network.target

[Service]
Type=simple
User=healthcare
WorkingDirectory=/opt/healthcare/backend
EnvironmentFile=/opt/healthcare/backend/.env
ExecStart=/opt/healthcare/backend/healthcare-server
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
